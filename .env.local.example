# Copy this file to .env.local and fill in real values. .env.local is already gitignored.

# Groq API key — https://console.groq.com -> API Keys (free tier)
GROQ_API_KEY=

# Upstash Redis — https://console.upstash.com -> create a Redis database (free tier) -> REST API section
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
